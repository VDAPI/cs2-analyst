{
  "name": "cs2-analyst",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "npm": "^10"
  },
  "scripts": {
    "predev": "prisma db execute --schema prisma/schema.prisma --file prisma/pre-push.sql && prisma db push",
    "dev": "next dev --turbo --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:push": "prisma db execute --schema prisma/schema.prisma --file prisma/pre-push.sql && prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "preworker:parse": "prisma db execute --schema prisma/schema.prisma --file prisma/pre-push.sql && prisma db push --skip-generate",
    "worker:parse": "tsx workers/demo-parser.worker.ts",
    "worker:faceit": "tsx workers/faceit-demo-download.worker.ts",
    "setup:local": "npm run db:push && tsx --tsconfig tsconfig.json scripts/local-seed.ts",
    "test:clutches": "tsx --tsconfig tsconfig.json scripts/test-clutch-wins.ts",
    "test:sides": "tsx --tsconfig tsconfig.json scripts/test-sides.ts",
    "test:e2e-demo": "tsx --tsconfig tsconfig.json scripts/e2e-parse.ts",
    "test:replay": "tsx --tsconfig tsconfig.json scripts/test-replay-ticks.ts",
    "backfill:replay": "tsx --tsconfig tsconfig.json scripts/backfill-replay-ticks.ts",
    "test:library": "tsx --tsconfig tsconfig.json scripts/test-library.ts",
    "test:mechanics": "tsx --tsconfig tsconfig.json scripts/test-movement.ts",
    "test:aim": "tsx --tsconfig tsconfig.json scripts/test-aim.ts",
    "test:findings": "tsx --tsconfig tsconfig.json scripts/test-findings.ts",
    "test:utility": "tsx --tsconfig tsconfig.json scripts/test-utility.ts",
    "test:platform": "tsx --tsconfig tsconfig.json scripts/test-platform.ts",
    "test:scouting": "tsx --tsconfig tsconfig.json scripts/test-scouting.ts",
    "test:tactics": "tsx --tsconfig tsconfig.json scripts/test-tactics.ts",
    "test:admin": "tsx --tsconfig tsconfig.json scripts/test-admin.ts",
    "admin:grant": "tsx --tsconfig tsconfig.json scripts/grant-admin.ts",
    "test:norms": "tsx --tsconfig tsconfig.json scripts/test-norms.ts",
    "test:roles": "tsx --tsconfig tsconfig.json scripts/test-roles.ts",
    "test:onboarding": "tsx --tsconfig tsconfig.json scripts/test-onboarding.ts",
    "pro:import": "tsx --tsconfig tsconfig.json scripts/import-pro-demos.ts",
    "norms:refresh": "tsx --tsconfig tsconfig.json scripts/refresh-norms.ts",
    "test:progress": "tsx --tsconfig tsconfig.json scripts/test-progress.ts",
    "test:coach": "tsx --tsconfig tsconfig.json scripts/test-coach.ts",
    "test:training": "tsx --tsconfig tsconfig.json scripts/test-training.ts",
    "test:security": "tsx --tsconfig tsconfig.json scripts/test-security.ts",
    "test:team": "tsx --tsconfig tsconfig.json scripts/test-team.ts",
    "test:e2e": "playwright test",
    "test:e2e:update-snapshots": "bash scripts/e2e-snapshots.sh",
    "e2e:seed": "tsx --tsconfig tsconfig.json scripts/e2e-seed.ts",
    "test:winprob": "tsx --tsconfig tsconfig.json scripts/test-winprob.ts",
    "ml:install": "python3 -m pip install -r ml/requirements.txt",
    "ml:train": "cd ml && python3 -m cs2ml.train",
    "ml:serve": "cd ml && python3 -m cs2ml.server",
    "ml:test": "cd ml && python3 -m pytest -q"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@laihoe/demoparser2": "^0.41.3",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.4.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@sentry/nextjs": "10.75.3",
    "@sentry/node": "10.75.3",
    "@tanstack/react-query": "^5.60.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.30.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "d3": "^7.9.0",
    "framer-motion": "^11.15.0",
    "fzstd": "^0.1.1",
    "geist": "^1.7.0",
    "ioredis": "^5.4.0",
    "lucide-react": "^0.460.0",
    "next": "15.1.0",
    "next-auth": "^4.24.0",
    "next-auth-steam": "^0.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "unbzip2-stream": "^1.4.3",
    "web-push": "^3.6.7",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/d3": "^7.4.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.1.0",
    "prisma": "^6.4.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
