generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                 String    @id @default(cuid())
  steamId            String?   @unique
  faceitId           String?   @unique
  faceitNickname     String?
  lastFaceitSync     DateTime?
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  plan               Plan      @default(FREE)
  role               UserRole  @default(USER)
  monthlyDemoLimit   Int? // admin override of PLAN_LIMITS[plan].monthlyDemos (null = plan default)
  locale             String    @default("pl") // UI language ("pl" | "en"), also used for push notifications
  // Premier / Steam match history (opt-in, S18): the player's own "game
  // authentication code" plus the newest share code we know. Never set
  // unless the player asked for it in Settings.
  steamAuthCode      String?
  steamLastShareCode String?
  lastSteamSync      DateTime?
  // Public profile (S16): off until the player switches it on in Settings;
  // the slug is the /u/<slug> address.
  publicProfile      Boolean   @default(false)
  // "Play like a pro" (S24): the pro player (steamId from the pro pool) the
  // player compares themselves with; null = the pool's busiest player.
  favoriteProSteamId String?
  publicSlug         String?   @unique
  // Onboarding (S21): when the player finished or skipped the report guide;
  // null = show it on the next report they open.
  reportTourAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  matchPlayers      MatchPlayer[]
  teams             TeamMember[]
  uploads           DemoUpload[]
  faceitMatches     FaceitMatch[]
  steamMatches      SteamMatch[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  goals             Goal[]
  shares            Share[]
  mapNotes          MapNote[]
  trainingPlans     TrainingPlan[]
  coachTexts        CoachText[]
  coachFeedback     CoachFeedback[]
  lineupMastery     LineupMastery[]
}

enum UserRole {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
  TEAM
}

// ─── Demo & Match ────────────────────────────────────────

model DemoUpload {
  id             String       @id @default(cuid())
  userId         String
  fileName       String
  fileUrl        String
  fileSize       Int
  status         ParseStatus  @default(QUEUED)
  progress       Int          @default(0) // 0-100, shown in the analysis queue
  source         UploadSource @default(MANUAL)
  faceitMatchId  String? // per user: @@unique([userId, faceitMatchId]) below
  error          String?
  matchId        String?      @unique
  // fileUrl is a local path, or "r2://<key>" when the demo lives in R2
  // (src/lib/storage/demo-store.ts). Empty while a FACEIT download is pending.
  keepDemo       Boolean      @default(false) // "keep demo": skip deleting the .dem after analysis
  demoDeletedAt  DateTime? // set once the .dem is gone from disk/R2
  deletedAt      DateTime? // analysis deleted by the user; row kept so the monthly limit still counts it
  parseStartedAt DateTime? // last time the parser picked it up (admin metrics)
  parseMs        Int? // wall time of the last successful parse + persist, in ms
  retries        Int          @default(0) // times a failed/stuck analysis was queued again
  // Pro demo (S13): part of the pro pool the norms are measured on. Owned by
  // the pro-pool system user (src/lib/norms/pro-pool.ts), never a player.
  pro            Boolean      @default(false)
  proLabel       String? // e.g. "Vitality vs MOUZ, IEM Cologne 2026" (admin-entered)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  match       Match?       @relation(fields: [matchId], references: [id])
  faceitMatch FaceitMatch?
  steamMatch  SteamMatch?

  // Two app users can be in the same FACEIT match: one upload per user.
  @@unique([userId, faceitMatchId])
  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@index([createdAt])
  @@index([faceitMatchId])
}

enum UploadSource {
  MANUAL
  FACEIT
  STEAM // Premier / matchmaking, imported by share code or replay link
}

enum ParseStatus {
  QUEUED
  DOWNLOADING
  PARSING
  COMPLETED
  FAILED
}

model Match {
  id         String   @id @default(cuid())
  map        String
  date       DateTime
  duration   Int // seconds
  server     String?
  shareCode  String?  @unique
  scoreCT    Int
  scoreT     Int
  tickRate   Int      @default(64)
  totalTicks Int
  createdAt  DateTime @default(now())

  upload      DemoUpload?
  rounds      Round[]
  players     MatchPlayer[]
  mechanics   MechanicsStats[]
  aim         AimStats[]
  utility     UtilityStats[]
  tactics     TacticsStats[]
  findings    Finding[]
  normSamples NormSample[]
  winProbData WinProbData?
  situations  ProSituation[]
  shares      Share[]
  coachTexts  CoachText[]
  mapNotes    MapNote[]

  // FINDINGS_STAMP the stored findings were built with (null = never); a
  // different stamp makes the report rebuild them (src/lib/findings/persist.ts).
  findingsVersion String?
  findingsWpModel String? // win-probability model the findings' costs were scored with (S14)
}

model MatchPlayer {
  id      String    @id @default(cuid())
  matchId String
  userId  String?
  steamId String
  name    String
  team    Team_Side

  // Aggregate stats
  kills          Int   @default(0)
  deaths         Int   @default(0)
  assists        Int   @default(0)
  adr            Float @default(0)
  hltvRating     Float @default(0)
  hsPercent      Float @default(0)
  utilityDamage  Int   @default(0)
  flashAssists   Int   @default(0)
  firstKills     Int   @default(0)
  firstDeaths    Int   @default(0)
  clutchWins     Int   @default(0)
  clutchAttempts Int   @default(0)

  // Rank in this match (S13): "faceit" (level 1-10, from the FACEIT match
  // room), "premier" (CS Rating from the demo) or "competitive" (skill group
  // 1-18 from the demo). Null when unknown.
  rankType  String?
  rankValue Int?

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])

  @@unique([matchId, steamId])
  @@index([steamId])
}

enum Team_Side {
  CT
  T
}

// ─── Round ───────────────────────────────────────────────

model Round {
  id         String    @id @default(cuid())
  matchId    String
  number     Int
  winner     Team_Side
  winReason  WinReason
  startTick  Int
  endTick    Int
  ctScore    Int
  tScore     Int
  ctEquipVal Int       @default(0)
  tEquipVal  Int       @default(0)
  ctMoney    Int       @default(0)
  tMoney     Int       @default(0)
  buyType_CT BuyType   @default(UNKNOWN)
  buyType_T  BuyType   @default(UNKNOWN)

  match    Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  kills    Kill[]
  grenades GrenadeEvent[]
  bombs    BombEvent[]
  players  RoundPlayer[]
  ticks    RoundTicks?
  shots    ShotEvent[]
  damages  DamageEvent[]
  reloads  ReloadEvent[]

  @@unique([matchId, number])
}

model RoundPlayer {
  id         String  @id @default(cuid())
  roundId    String
  steamId    String
  equipValue Int     @default(0)
  money      Int     @default(0)
  damage     Int     @default(0)
  buyType    BuyType @default(UNKNOWN)

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, steamId])
  @@index([steamId])
}

enum WinReason {
  ELIMINATION
  BOMB_EXPLODED
  BOMB_DEFUSED
  TIME_RAN_OUT
  TARGET_SAVED
}

enum BuyType {
  FULL_BUY
  FORCE_BUY
  ECO
  HALF_BUY
  PISTOL
  UNKNOWN
}

// ─── Events ──────────────────────────────────────────────

model Kill {
  id              String  @id @default(cuid())
  roundId         String
  tick            Int
  attackerSteamId String
  attackerName    String
  victimSteamId   String
  victimName      String
  assisterSteamId String?
  weapon          String
  headshot        Boolean @default(false)
  wallbang        Boolean @default(false)
  throughSmoke    Boolean @default(false)
  noScope         Boolean @default(false)
  flashAssisted   Boolean @default(false)
  attackerPosX    Float
  attackerPosY    Float
  attackerPosZ    Float
  victimPosX      Float
  victimPosY      Float
  victimPosZ      Float
  isFirstKill     Boolean @default(false)
  // Victim's inventory at death (item names), for "died with unused utility"
  // (S11). Null for kills parsed before S11 or when the parser could not read it.
  victimInventory Json?

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([attackerSteamId])
  @@index([victimSteamId])
}

model GrenadeEvent {
  id             String      @id @default(cuid())
  roundId        String
  tick           Int
  throwerSteamId String
  throwerName    String
  grenadeType    GrenadeType
  throwPosX      Float
  throwPosY      Float
  throwPosZ      Float
  landPosX       Float
  landPosY       Float
  landPosZ       Float
  trajectory     Json? // Array of {tick, x, y, z}
  duration       Int? // ms for smokes/molotovs
  damageDealt    Int         @default(0)
  playersFlashed Int         @default(0)

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([throwerSteamId])
}

enum GrenadeType {
  SMOKE
  FLASH
  HE
  MOLOTOV
  INCENDIARY
  DECOY
}

model BombEvent {
  id            String     @id @default(cuid())
  roundId       String
  tick          Int
  type          BombAction
  playerSteamId String
  posX          Float
  posY          Float
  posZ          Float
  site          String? // A or B

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
}

enum BombAction {
  PLANT_BEGIN
  PLANTED
  DEFUSE_BEGIN
  DEFUSED
  EXPLODED
  DROPPED
  PICKED_UP
}

// ─── Replay data (survives deleting the .dem) ───────────

// Sampled player state for one round, so the 2D replay and the mechanics
// analysis work after the .dem file is gone. Encoded by
// src/lib/replay/round-ticks.ts: delta-encoded Int16 columns, gzipped.
model RoundTicks {
  id         String @id @default(cuid())
  roundId    String @unique
  version    Int    @default(1) // encoding version
  startTick  Int
  interval   Int // ticks between frames; frame i is at startTick + i * interval
  frameCount Int
  players    Json // [{ steamId, name }] — column order inside data
  weapons    Json // string[] — weapon column holds an index into this
  data       Bytes
  byteSize   Int // compressed size of data, for monitoring storage per match

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
}

// Every weapon_fire, with the shooter's exact state on that tick (movement
// accuracy, counter-strafe, first-bullet analysis).
model ShotEvent {
  id      String @id @default(cuid())
  roundId String
  tick    Int
  steamId String
  weapon  String
  x       Float
  y       Float
  z       Float
  pitch   Float
  yaw     Float
  velX    Float
  velY    Float
  velZ    Float

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId])
  @@index([steamId])
}

// Every player_hurt, with both players' positions and view angles.
model DamageEvent {
  id              String  @id @default(cuid())
  roundId         String
  tick            Int
  attackerSteamId String?
  victimSteamId   String
  weapon          String
  dmgHealth       Int
  dmgArmor        Int
  healthAfter     Int
  armorAfter      Int
  hitgroup        String
  attackerX       Float?
  attackerY       Float?
  attackerZ       Float?
  attackerPitch   Float?
  attackerYaw     Float?
  victimX         Float
  victimY         Float
  victimZ         Float

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId])
  @@index([attackerSteamId])
  @@index([victimSteamId])
}

// Every weapon_reload (reload at a bad moment, S9). clip = rounds left when the
// reload started.
model ReloadEvent {
  id      String @id @default(cuid())
  roundId String
  tick    Int
  steamId String
  weapon  String
  clip    Int?
  x       Float
  y       Float
  z       Float

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId])
}

// ─── Mechanics analysis ─────────────────────────────────

// Per player per match: movement while shooting, counter-strafe, first-bullet
// accuracy (src/lib/analysis/movement.ts). Computed from ShotEvent /
// DamageEvent / RoundTicks, so it can be recomputed without the .dem.
model MechanicsStats {
  id      String @id @default(cuid())
  matchId String
  steamId String
  version Int // MECHANICS_VERSION; older rows are recomputed

  shots                 Int
  movingShots           Int
  firstShots            Int // first shot of a burst in an engagement
  firstShotsMoving      Int
  firstShotHits         Int
  sprayShots            Int // later shots of engagement bursts
  sprayShotsMoving      Int
  sprayHits             Int
  hits                  Int
  headHits              Int
  counterStrafes        Int
  counterStrafeAvgMs    Float?
  counterStrafeMedianMs Float?
  shotBeforeStop        Int

  weapons Json // WeaponMechanics[]
  moments Json // MovementMoment[] — moving first shots

  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, steamId])
  @@index([steamId])
}

// Per player per match: aim and duels (src/lib/analysis/aim.ts) — crosshair
// placement, reaction, time to damage, spray, flick/tracking, peeks, noise,
// jumps, reloads. Computed from the stored replay data, never the .dem.
model AimStats {
  id      String @id @default(cuid())
  matchId String
  steamId String
  version Int // AIM_VERSION; older rows are recomputed

  visibility String // "spotted" (game line of sight) | "fov" (approximation) | "mixed"

  duels              Int
  duelsUnseen        Int // duels opened by an enemy the player could not see
  crosshairSamples   Int
  crosshairAvgDeg    Float?
  crosshairMedianDeg Float?
  crosshairBad       Int
  reactionSamples    Int
  reactionMedianMs   Float?
  ttdSamples         Int
  ttdMedianMs        Float?
  sprays             Int
  sprayBullets       Int // bullets 4+ of engagement sprays
  sprayHits          Int
  flicks             Int
  trackings          Int
  preaims            Int
  overflicks         Int
  peeks              Int
  peeksWon           Int
  dryPeeks           Int
  dryPeeksLost       Int
  noiseEpisodes      Int
  noiseCostly        Int
  jumps              Int
  jumpsNearEnemy     Int
  airShots           Int
  reloads            Int
  badReloads         Int
  reloadData         Boolean

  peekTypes Json // Record<PeekType, { count, won, lost }>
  moments   Json // AimMoment[]

  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, steamId])
  @@index([steamId])
}

// Per player per match: smokes, flashes, molotovs, HEs and utility left at
// death (src/lib/analysis/utility.ts). Computed from GrenadeEvent / ShotEvent
// (grenade throws) / DamageEvent / Kill / RoundTicks, so no .dem is needed.
// Lineup trainer (S22): lineups a player marked as mastered. `key` is
// Lineup.key from src/lib/analysis/lineups.ts (type, technique, rounded spots).
model LineupMastery {
  id        String   @id @default(cuid())
  userId    String
  map       String
  key       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, map, key])
}

model UtilityStats {
  id      String @id @default(cuid())
  matchId String
  steamId String
  version Int // UTILITY_VERSION; older rows are recomputed

  smokes             Int
  smokesVoid         Int // no enemy influence, no info, no team action
  smokesEarly        Int // void and early in the round, or faded before enemies came
  flashes            Int
  flashesBlinding    Int // blinded at least one enemy for 1 s+
  flashesFollowed    Int // of those: a blinded enemy was seen, hit or killed by the team in time
  flashEnemySec      Float
  flashTeamSec       Float // teammates and self
  teamFlashes        Int // blinded a teammate (or self) for 1 s+
  hes                Int
  heDamage           Int
  molotovs           Int
  molotovDamage      Int
  nadeTeamDamage     Int
  nadesNoEffect      Int
  deaths             Int // deaths with a known inventory
  deathsWithUtility  Int
  unusedUtilityValue Int // $ of grenades held at those deaths
  inventoryData      Boolean

  throws  Json // UtilityThrow[] — throw origin + angles + landing, feeds the lineup base
  moments Json // UtilityMoment[]

  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, steamId])
  @@index([steamId])
}

// Teamplay, economy and positions for one player in one match (S12),
// computed from kills, damage, bombs, RoundPlayer economy and RoundTicks by
// src/lib/analysis/tactics.ts — no .dem needed.
model TacticsStats {
  id      String @id @default(cuid())
  matchId String
  steamId String
  version Int // TACTICS_VERSION; older rows are recomputed

  rounds         Int
  deaths         Int
  tradedDeaths   Int
  isolatedDeaths Int // untraded deaths with no teammate in trade range
  tradeChances   Int // nearest teammate to a death, killer within reach
  tradesMade     Int
  openingDuels   Int
  openingWins    Int
  anchorRounds   Int // CT rounds with a setup spot (halves with 5+)
  sameSpotRounds Int // of which at the most used spot
  forceRounds    Int
  badForces      Int

  moments Json // TacticsMoment[]

  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, steamId])
  @@index([steamId])
}

// The game's own callout names (last_place_name) on a 128-unit grid per map,
// summed over every parsed demo. Names smoke landings and lineups (S11).
model MapPlaceCell {
  map   String
  cx    Int
  cy    Int
  cz    Int
  place String
  count Int

  @@id([map, cx, cy, cz, place])
  @@index([map])
}

// One detected mistake at one moment (src/lib/findings/). Built from the
// stored analysis (MechanicsStats, AimStats — later utility, teamplay,
// economy), so it can be rebuilt without the .dem. `type` is a key of
// FINDING_TYPES; advice is stored per row so S15 can rewrite it per player.
model Finding {
  id            String  @id @default(cuid())
  matchId       String
  steamId       String
  type          String // FindingType (catalog.ts)
  category      String // FindingCategory
  severity      String // high | medium | low
  roundNumber   Int
  tick          Int
  roundTime     Float // seconds since round start
  costly        Boolean // lost duel, damage taken, death or missed shot
  targetSteamId String? // enemy the mistake was against
  values        Json // FindingValue[]
  detail        String
  advice        String
  // What it cost the team (S14, src/lib/winprob/impact.ts): the team's round
  // win probability before / after the consequence (0–1), and how it was
  // measured ("death" | "mate_death" | "trade" | "drop"). Null = no rule or
  // no replay data for that round.
  wpBefore      Float?
  wpAfter       Float?
  wpKind        String?

  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, steamId])
  @@index([steamId, type])
}

// ─── FACEIT ──────────────────────────────────────────

model FaceitMatch {
  id              String          @id @default(cuid())
  userId          String
  faceitMatchId   String
  map             String
  score           String // e.g. "16-9"
  date            DateTime
  faceitUrl       String
  competition     String?
  result          MatchResult? // the user's result; null for matches synced before it was stored
  demoResourceUrl String? // demo_url[0] from Data API — exchanged for a signed URL at download time
  demoStatus      DemoFetchStatus @default(UNKNOWN)
  uploadId        String?         @unique // linked when user uploads/downloads demo
  createdAt       DateTime        @default(now())

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  upload DemoUpload? @relation(fields: [uploadId], references: [id])

  // Every app user in the same FACEIT match gets their own row (own result).
  @@unique([userId, faceitMatchId])
  @@index([faceitMatchId])
}

enum MatchResult {
  WIN
  LOSS
}

enum DemoFetchStatus {
  UNKNOWN
  AVAILABLE
  NOT_READY
  DOWNLOADED
  FAILED
}

// ─── Premier / Steam (opt-in) ──────────────────────────

// One Premier / matchmaking match the player imported by share code, or that
// the Steam match history sync found. matchId / outcomeId / tvPort are decoded
// from the share code (src/lib/steam/share-code.ts). demoUrl is a Valve replay
// link (replayN.valve.net/730/..._....dem.bz2) when the player pasted one; the
// demo is then downloaded only when the player clicks "Analyze".
model SteamMatch {
  id        String   @id @default(cuid())
  userId    String
  shareCode String
  matchId   String // uint64 as decimal string
  outcomeId String // uint64 as decimal string (reservation id)
  tvPort    Int
  demoUrl   String?
  uploadId  String?  @unique
  createdAt DateTime @default(now())

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  upload DemoUpload? @relation(fields: [uploadId], references: [id])

  @@unique([userId, shareCode])
  @@index([userId, createdAt])
}

// ─── Notifications (S18) ────────────────────────────────

enum NotificationType {
  ANALYSIS_DONE
  ANALYSIS_FAILED
}

// In-app notification (bell in the top bar). Text is rendered at display time
// in the viewer's language from type + data, so nothing language-specific is
// stored.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  uploadId  String?
  matchId   String?
  data      Json // { map?, score?, fileName?, error? }
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Web Push subscription of one browser / installed PWA.
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Small key-value store for server-generated settings (VAPID keys when the
// env vars are not set, so push works without manual setup).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Teams ───────────────────────────────────────────────

model Team {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  createdAt DateTime @default(now())

  members TeamMember[]
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(PLAYER)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
}

enum TeamRole {
  OWNER
  COACH
  PLAYER
}

/// Cached FACEIT Data API responses (S23 scouting). Keyed by request, e.g.
/// "player-stats:<id>"; rows past `expiresAt` are refetched and overwritten.
model FaceitApiCache {
  key       String   @id
  body      Json
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

// ─── Norms (S13) ─────────────────────────────────────────

/// One player's report metrics in one match, for one side ("CT" | "T" |
/// "all"), computed by the same analysis as the report
/// (src/lib/norms/sample.ts). The pro pool and the rank pools are built from
/// these rows; `metrics` is { "<metric>@<situation>": [value, samples] }.
model NormSample {
  id      String  @id @default(cuid())
  matchId String
  steamId String
  side    String // "CT" | "T" | "all"
  map     String
  pro     Boolean // from a pro demo (DemoUpload.pro)
  version String // NORMS_STAMP; older rows are recomputed
  metrics Json
  /// Role in this sample (S24, src/lib/roles/roles.ts): the side's role on
  /// "CT"/"T" rows, the match role on "all". Pro rows also feed "pro/<role>".
  role    String?
  /// SideProfile of the side (timing, team spacing, setup spots); null on "all".
  profile Json?

  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, steamId, side])
  @@index([pro, version])
  @@index([steamId, version])
}

/// Percentiles of one metric in one pool, map, side and situation, rebuilt
/// from NormSample by refreshNorms() (src/lib/norms/persist.ts). Pool is
/// "pro", "all" (every analysed player) or a rank bucket ("faceit:7",
/// "premier:15000", "competitive:12").
model MetricNorm {
  id        String   @id @default(cuid())
  pool      String
  map       String // "all" or the map name
  side      String // "CT" | "T" | "all"
  situation String // "all" or a weapon class ("rifle", "awp", "smg", "pistol")
  metric    String // ReportMetric.key
  n         Int // player-matches
  p10       Float
  p25       Float
  p50       Float
  p75       Float
  p90       Float
  mean      Float
  updatedAt DateTime @updatedAt

  @@unique([pool, map, side, situation, metric])
  @@index([pool])
}

// ─── Progress and sharing (S16) ───

// A target for one progress metric (src/lib/progress/metrics.ts); whether
// lower or higher is better comes from the metric, not the row.
model Goal {
  id         String    @id @default(cuid())
  userId     String
  metric     String // ProgressMetricKey
  target     Float
  achievedAt DateTime? // first time the last-5-match average met the target
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, metric])
}

// A public link (/s/<token>) to one player's report of a match, or to one
// moment of its replay. Revoking keeps the row so the link stays dead.
model Share {
  id          String    @id @default(cuid())
  token       String    @unique
  userId      String
  matchId     String
  kind        String // "report" | "moment"
  steamId     String? // player the report / moment is about
  roundNumber Int? // moment only
  tick        Int? // moment only
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([matchId])
}

// A note pinned to a spot on the map at a moment of a round (2D replay).
// x/y are game-world coordinates.
model MapNote {
  id          String   @id @default(cuid())
  userId      String
  matchId     String
  roundNumber Int
  tick        Int
  x           Float
  y           Float
  text        String
  createdAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, roundNumber])
  @@index([userId])
}

// ─── AI coach (S15) ──────────────────────────────────────

// The weekly training plan of one user (one row per week), rebuilt from the
// player's latest matches after every analysis (src/lib/coach/plan.ts).
model TrainingPlan {
  id        String   @id @default(cuid())
  userId    String
  steamId   String // player the plan is for
  weekStart String // Monday, YYYY-MM-DD (Europe/Warsaw)
  factsHash String // hash of the plan content; a change rewrites the AI text
  content   Json // TrainingPlanContent
  doneDays  Int[]    @default([]) // days (0 = Monday) the player ticked off
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  texts CoachText[]

  @@unique([userId, weekStart])
}

// Text written by the AI coach for a match report or a plan, per language,
// valid while factsHash matches the facts it was written from.
model CoachText {
  id        String   @id @default(cuid())
  userId    String
  key       String // "match:<matchId>:<steamId>" | "plan:<planId>"
  locale    String
  factsHash String
  model     String
  rejected  Int      @default(0) // items replaced by standard text (ungrounded numbers)
  content   Json // CoachMatchText | CoachPlanText (partial)
  matchId   String?
  planId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match?        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  plan  TrainingPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([userId, key, locale])
  @@index([userId, createdAt])
}

// "Helpful / not helpful" on one piece of advice (a finding type) in one
// place: "match:<matchId>" or "plan:<weekStart>". Sets the order of advice.
model CoachFeedback {
  id        String   @id @default(cuid())
  userId    String
  type      String // FindingType
  context   String
  helpful   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, context, type])
  @@index([type])
}

// ─── Round win probability (S14) ─────────────────────────

/// Training snapshots of one match for the win-probability model, built from
/// the stored replay data by src/lib/winprob/features.ts. `rows` is
/// [roundNumber, tick, tWin, ...features] with null where a feature does not
/// apply; `features` names the columns. Read by the Python trainer (ml/).
model WinProbData {
  id        String   @id @default(cuid())
  matchId   String   @unique
  version   Int // WP_FEATURES_VERSION
  map       String
  pro       Boolean
  rounds    Int
  features  Json // string[]
  rows      Json // (number | null)[][]
  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([version])
}

/// A trained win-probability model (ml/cs2ml/train.py). `spec` is scored by
/// src/lib/winprob/model.ts; only the active one whose featuresVersion matches
/// the app's WP_FEATURES_VERSION is used, otherwise the shipped prior.
model WinProbModel {
  id              String   @id @default(cuid())
  kind            String // "logistic" | "lgbm" | "lgbm_mono"
  featuresVersion Int
  spec            Json
  metrics         Json // out-of-fold comparison of every candidate
  nMatches        Int
  nRounds         Int
  nRows           Int
  active          Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([active])
}

/// One alive player at one moment of a pro demo, with what they did next
/// (src/lib/winprob/situations.ts) — the base of "co zrobiłby pro".
model ProSituation {
  id          String  @id @default(cuid())
  matchId     String
  version     Int // SITUATIONS_VERSION
  map         String
  roundNumber Int
  tick        Int
  steamId     String
  side        String // "CT" | "T"
  aliveUs     Int
  aliveThem   Int
  planted     Boolean
  timeLeft    Float
  x           Float
  y           Float
  z           Float
  hp          Int
  action      String // ProAction
  kill        Boolean
  died        Boolean
  wpBefore    Float
  wpAfter     Float
  modelId     String  @default("") // WinProbModel.id (or "prior") that scored wpBefore/wpAfter

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([map, side, planted, aliveUs, aliveThem])
  @@index([matchId])
}
